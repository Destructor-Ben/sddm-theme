---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
    - accent
  hex_format: "\"#{{R}}{{G}}{{B}}{{Z}}\""
  filename: "./themes/catppuccin-rounded-{{flavor.identifier}}-{{accent}}/Components/SleepButton.qml"
---
import QtQuick 2.15
import QtQuick.Controls 2.15

Item {
  implicitHeight: sleepButton.height
  implicitWidth: sleepButton.width
  Button {
    id: sleepButton
    height: config.IconSize
    width: config.IconSize
    hoverEnabled: true
    icon {
      source: Qt.resolvedUrl("../assets/sleep.svg")
      height: height
      width: width
      color: config.PowerButtonIconColor
    }
    background: Rectangle {
      id: sleepButtonBg
      radius: config.CircularPowerAndSessionButtons ? height / 2 : config.PowerAndSessionButtonBorderRadius
      color: config.PowerButtonColor
    }
    states: [
      State {
        name: "hovered"
        when: sleepButton.hovered
        PropertyChanges {
          target: sleepButtonBg
          color: {{rosewater.hex}}
        }
      }
    ]
    transitions: Transition {
      PropertyAnimation {
        properties: "color"
        duration: config.TransitionDuration
      }
    }
    onClicked: sddm.suspend()
  }
}
