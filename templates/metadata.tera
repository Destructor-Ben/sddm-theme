---
whiskers:
  version: "^2.5.1"
  matrix:
    - flavor
    - accent
  filename: "./themes/catppuccin-{{flavor.identifier}}-{{accent}}/metadata.desktop"
---
[SddmGreeterTheme]
Name=Catppuccin Rounded ({{flavor.name}} {{accent}})
Description=Soothing & soft-edged pastel theme for SDDM
Type=sddm-theme
Version=0.1
Website=https://github.com/destructor-ben/sddm-theme
Screenshot=preview.png
MainScript=Main.qml
ConfigFile=theme.conf
TranslationsDirectory=translations
Theme-Id=Catppuccin-Rounded
Theme-API=2.0
License=MIT
QtVersion=6
